# Dev seed accounts documented in scripts/k6/README.md. Never point this at production.
RAGAS_BASE_URL=http://localhost:9080
# Free-form label recorded in the manifest/report to tell backends apart.
RAGAS_TARGET_LABEL=Spring 主后端
RAGAS_DRIVER_USERNAME=ce@ce.com
RAGAS_DRIVER_PASSWORD=123456
RAGAS_ADMIN_USERNAME=superadmin
RAGAS_ADMIN_PASSWORD=SuperAdmin@123456

# Product generator: record the model the server was started with (OLLAMA_MODEL).
RAGAS_ANSWER_MODEL=llama3.2
# Product embedding model configured in application.yml (rag.embedding.model).
RAGAS_PRODUCT_EMBEDDING_MODEL=nomic-embed-text

# RAGAS judge and similarity embeddings. Judge must be a capable Chinese model.
RAGAS_JUDGE_MODEL=qwen2.5:7b
RAGAS_JUDGE_EMBEDDING_MODEL=bge-m3

RAGAS_OLLAMA_URL=http://localhost:11434
RAGAS_ES_URL=http://localhost:9200
# Must match rag.index.alias on the server (RAG_INDEX_ALIAS).
RAGAS_INDEX_ALIAS=rag_chunk_current
RAGAS_TOP_K=5
