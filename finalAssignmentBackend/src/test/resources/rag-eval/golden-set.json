{
  "corpus": [
    {"chunkId":"c-fine-payment-guide","documentId":"doc-fine-01","title":"罚款缴纳指南","content":"违法罚款可通过交管12123、银行柜台或线上支付平台缴纳，需在处罚决定书送达后15日内完成缴纳，逾期将产生滞纳金。","sourceType":"BUSINESS","sourceField":"content","route":"/fine/payment","aclScope":"PUBLIC"},
    {"chunkId":"c-fine-late-fee","documentId":"doc-fine-02","title":"滞纳金计算规则","content":"逾期未缴纳罚款的，每日按罚款金额的百分之三加处罚款，滞纳金总额不得超过罚款本金。","sourceType":"BUSINESS","sourceField":"content","route":"/fine/late-fee","aclScope":"PUBLIC"},
    {"chunkId":"c-fine-payment-methods","documentId":"doc-fine-03","title":"罚款缴纳方式","content":"罚款支持微信支付、支付宝、银行卡转账和现金四种缴纳渠道，缴款成功后系统自动生成电子票据。","sourceType":"BUSINESS","sourceField":"content","route":"/fine/methods","aclScope":"PUBLIC"},
    {"chunkId":"c-fine-receipt","documentId":"doc-fine-04","title":"电子票据下载","content":"缴款完成后可在我的票据页面下载电子票据，电子票据与纸质票据具有同等法律效力。","sourceType":"BUSINESS","sourceField":"content","route":"/fine/receipt","aclScope":"PUBLIC"},
    {"chunkId":"c-fine-refund","documentId":"doc-fine-05","title":"罚款退款处理","content":"违法记录被撤销后，已缴纳的罚款将原路退回，退款一般在三个工作日内到账。","sourceType":"BUSINESS","sourceField":"content","route":"/fine/refund","aclScope":"PUBLIC"},
    {"chunkId":"c-appeal-process","documentId":"doc-appeal-01","title":"申诉办理流程","content":"当事人对违法记录有异议的，可在收到处罚决定书之日起六十日内提交申诉，申诉需提供身份证明、行驶证及证据材料。","sourceType":"BUSINESS","sourceField":"content","route":"/appeal/create","aclScope":"PUBLIC"},
    {"chunkId":"c-appeal-evidence","documentId":"doc-appeal-02","title":"申诉证据要求","content":"申诉需上传证据照片或视频，证据应能清晰反映违法时间、地点及车辆号牌。","sourceType":"BUSINESS","sourceField":"content","route":"/appeal/evidence","aclScope":"PUBLIC"},
    {"chunkId":"c-appeal-deadline","documentId":"doc-appeal-03","title":"申诉时限规定","content":"超过法定期限的申诉将不予受理，请务必在收到处罚决定书六十日内提交申诉。","sourceType":"BUSINESS","sourceField":"content","route":"/appeal/deadline","aclScope":"PUBLIC"},
    {"chunkId":"c-license-points","documentId":"doc-license-01","title":"驾驶证记分规则","content":"一个记分周期内累积记分达到十二分的，驾驶人应当参加道路交通安全法律法规学习并接受考试。","sourceType":"BUSINESS","sourceField":"content","route":"/license/points","aclScope":"PUBLIC"},
    {"chunkId":"c-license-cycle","documentId":"doc-license-02","title":"记分周期说明","content":"记分周期为十二个月，自驾驶证初次领证之日起计算，周期结束后未满十二分的记分予以清除。","sourceType":"BUSINESS","sourceField":"content","route":"/license/cycle","aclScope":"PUBLIC"},
    {"chunkId":"c-license-restore","documentId":"doc-license-03","title":"满分学习考试","content":"记满十二分的驾驶人需参加为期七日的满分学习并通过科目一考试，考试合格后记分予以清除。","sourceType":"BUSINESS","sourceField":"content","route":"/license/restore","aclScope":"PUBLIC"},
    {"chunkId":"c-vehicle-registration","documentId":"doc-vehicle-01","title":"新车上牌流程","content":"新车上牌需携带购车发票、车辆合格证、交强险凭证及车主身份证明到车管所办理注册登记。","sourceType":"BUSINESS","sourceField":"content","route":"/vehicle/register","aclScope":"PUBLIC"},
    {"chunkId":"c-vehicle-inspection","documentId":"doc-vehicle-02","title":"车辆年检规定","content":"非营运小型客车前六年免上线检验，每两年申领一次检验标志，超过六年需每年上线检验一次。","sourceType":"BUSINESS","sourceField":"content","route":"/vehicle/inspection","aclScope":"PUBLIC"},
    {"chunkId":"c-vehicle-transfer","documentId":"doc-vehicle-03","title":"车辆过户办理","content":"车辆过户需买卖双方携带身份证、行驶证、登记证书到车管所办理转移登记。","sourceType":"BUSINESS","sourceField":"content","route":"/vehicle/transfer","aclScope":"PUBLIC"},
    {"chunkId":"c-offense-notice","documentId":"doc-offense-01","title":"违法通知方式","content":"违法记录生成后，系统通过短信、APP推送和邮寄三种方式通知车主，通知状态包括已发送和未发送。","sourceType":"BUSINESS","sourceField":"content","route":"/offense/notice","aclScope":"PUBLIC"},
    {"chunkId":"c-offense-speeding","documentId":"doc-offense-02","title":"超速处罚标准","content":"超速未达百分之二十的处警告或二百元以下罚款，超速百分之二十以上未达百分之五十的记六分并处罚款。","sourceType":"BUSINESS","sourceField":"content","route":"/offense/speeding","aclScope":"PUBLIC"},
    {"chunkId":"c-offense-parking","documentId":"doc-offense-03","title":"违停处罚标准","content":"机动车违章停车、违反规定停放的，处二十元以上二百元以下罚款，并可将车辆拖移至不妨碍交通的地点。","sourceType":"BUSINESS","sourceField":"content","route":"/offense/parking","aclScope":"PUBLIC"},
    {"chunkId":"c-progress-message","documentId":"doc-service-01","title":"业务进度消息","content":"业务办理进度通过站内消息实时推送，包括受理、审核、办结等节点，用户可在消息中心查看。","sourceType":"BUSINESS","sourceField":"content","route":"/message/progress","aclScope":"PUBLIC"},
    {"chunkId":"c-idempotency","documentId":"doc-service-02","title":"重复提交与幂等","content":"相同幂等键的重复请求只会执行一次，重复提交将返回首次处理结果，避免重复扣款或重复录入。","sourceType":"BUSINESS","sourceField":"content","route":"/service/idempotency","aclScope":"PUBLIC"},
    {"chunkId":"c-driver-profile","documentId":"doc-driver-01","title":"驾驶人信息维护","content":"驾驶人可在个人中心更新联系方式和住址，身份证号码变更需到窗口办理。","sourceType":"BUSINESS","sourceField":"content","route":"/driver/profile","aclScope":"PUBLIC"},
    {"chunkId":"c-account-security","documentId":"doc-account-01","title":"账户安全建议","content":"建议定期修改登录密码并开启二次验证，密码应包含大小写字母、数字和特殊字符。","sourceType":"BUSINESS","sourceField":"content","route":"/account/security","aclScope":"PUBLIC"},
    {"chunkId":"c-rag-assistant","documentId":"doc-ai-01","title":"智能助手使用说明","content":"智能助手可回答违法处理、缴费、申诉等常见问题，回答内容基于知识库检索生成并附带引用来源。","sourceType":"BUSINESS","sourceField":"content","route":"/ai/assistant","aclScope":"PUBLIC"},
    {"chunkId":"c-admin-offense-entry","documentId":"doc-admin-01","title":"违法记录录入规范","content":"管理员录入违法记录时必须填写违法代码、违法时间、违法地点和当事人信息，系统按幂等键防止重复录入。","sourceType":"ADMIN","sourceField":"content","route":"/admin/offense/entry","aclScope":"ROLE","aclRoles":["ADMIN","SUPER_ADMIN"]},
    {"chunkId":"c-admin-appeal-review","documentId":"doc-admin-02","title":"申诉审核操作指引","content":"审核申诉时应核对证据材料，可选择受理、不予受理或要求补充材料，审核结果实时通知当事人。","sourceType":"ADMIN","sourceField":"content","route":"/admin/appeal/review","aclScope":"ROLE","aclRoles":["ADMIN","SUPER_ADMIN"]},
    {"chunkId":"c-admin-audit-log","documentId":"doc-admin-03","title":"操作日志审查","content":"超级管理员可查询操作日志与登录日志，用于安全审计与异常行为排查。","sourceType":"ADMIN","sourceField":"content","route":"/admin/audit/log","aclScope":"ROLE","aclRoles":["SUPER_ADMIN"]},
    {"chunkId":"c-admin-rag-manage","documentId":"doc-admin-04","title":"知识库资料管理","content":"超级管理员可录入、上传和索引知识库资料，并执行索引重建与回填等高风险操作。","sourceType":"ADMIN","sourceField":"content","route":"/admin/rag/manage","aclScope":"ROLE","aclRoles":["SUPER_ADMIN"]},
    {"chunkId":"c-user-offense-mine","documentId":"doc-user-01","title":"我的违法记录","content":"本页面展示当前登录账号名下的违法记录明细及处理状态。","sourceType":"USER","sourceField":"content","route":"/user/offense","aclScope":"USER","aclUserIds":["driver-1001"]},
    {"chunkId":"c-user-vehicle-mine","documentId":"doc-user-02","title":"我的车辆信息","content":"本页面展示当前登录账号名下已登记的车辆信息及年检状态。","sourceType":"USER","sourceField":"content","route":"/user/vehicle","aclScope":"USER","aclUserIds":["driver-1001"]},
    {"chunkId":"c-dept-traffic-sop","documentId":"doc-dept-01","title":"交警执法现场规程","content":"现场执法需开启执法记录仪，全程录像并保存不少于六个月，执法记录仪数据不得随意删除。","sourceType":"DEPT","sourceField":"content","route":"/dept/traffic/sop","aclScope":"DEPARTMENT","aclDepartments":["traffic-police"]},
    {"chunkId":"c-dept-finance-sop","documentId":"doc-dept-02","title":"财务对账规程","content":"每日营业结束后核对缴款流水与系统记录，出现差异需当日查明原因并登记。","sourceType":"DEPT","sourceField":"content","route":"/dept/finance/sop","aclScope":"DEPARTMENT","aclDepartments":["finance"]}
